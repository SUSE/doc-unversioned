            <entry>Supported, but undocumented</entry>
          </row>
          <row>
            <entry>Performance optimized, with stand-alone S/4 Application Server in the same cluster</entry>
            <entry>Supported, but undocumented</entry>
          </row>
          <row>
            <entry>Cost optimized</entry>
            <entry>Supported, but undocumented</entry>
          </row>
          <row>
            <entry>Cost optimized, Multi-Target</entry>
            <entry>Non-supported</entry>
          </row>
          <row>
            <entry>Performance optimized, Multi-Target SR, third site in the same cluster</entry>
            <entry>Non-supported</entry>
          </row>
          <row>
            <entry>Two performance optimized clusters connected</entry>
            <entry>Non-supported</entry>
          </row>
        </tbody>
      </tgroup>
    </table>
  </section>

