      <tgroup cols="2">
      <colspec colwidth="6*"/>
      <colspec colwidth="4*"/>
        <thead>
          <row>
            <entry>&hana; scale-up configuration</entry>
            <entry>Status</entry>
          </row>
        </thead>
        <tbody>
          <row>
            <entry>Performance optimized</entry>
